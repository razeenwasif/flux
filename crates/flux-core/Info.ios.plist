<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  iOS only; Tauri merges this into the app's Info.plist (ADR 0021).

  iOS 27 stops any app built with its SDK at launch unless the app uses
  scenes. The tao in Tauri 2.11 makes its window the old way, so Flux declares
  one scene here, and FluxSceneDelegate (tauri-plugin-flux-webview's iOS
  package) moves tao's view controller into a window made for it.
-->
<plist version="1.0">
<dict>
	<!-- Flux's Documents folder (where Files opens) shows in the iOS Files app
	     as On My iPhone › Flux, and files there open in place. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- flux-browser://open?url=… : how the "Send to Flux" share extension
	     (ios/ShareExtension) hands Flux a link to open in a new tab. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.flux.browser.open</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>flux-browser</string>
			</array>
		</dict>
	</array>
	<!-- The phone link (MacLink.swift): Flux on your Mac answers on its
	     Tailscale name with a certificate of its own, which the app pins. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>ts.net</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default</string>
					<key>UISceneDelegateClassName</key>
					<string>FluxSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
