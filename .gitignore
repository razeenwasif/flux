# Rust
/target
**/*.rs.bk

# Node
node_modules
dist
dist-preview
.vite

# UI preview / screenshot scratch
.playwright-mcp

# Tauri
crates/flux-core/gen

# Local AI models — never commit weights (multi-GB GGUF files)
/models
*.gguf

# ── Secrets & local user data — NEVER commit ─────────────────────────────────
# Password vault (#61). Lives in the OS app-data dir, but these guard the dev
# fallback that writes to the CWD when app_data_dir can't resolve.
/vault/
vault.bin
key.bin
keywrap.json
# Session / extension stores — CWD fallbacks if app_data_dir can't resolve.
flux-session.json
flux-extensions.json
flux-ext-storage.json
# Password-manager exports dropped in to import (Proton Pass etc.) carry real
# credentials. Keep any CSV/ZIP/JSON exports under secrets/ or private/.
*.pgp
*.gpg
/secrets/
/private/
# Environment & credential files.
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx

# OS / editor noise
.DS_Store
*.log
flux-shell-default.png

# Windows Mark-of-the-Web alternate-data-stream metadata (illegal paths on NTFS)
*:Zone.Identifier

# Research corpus: keep the synthesis (RESEARCH.md) + metadata in the repo,
# but not the ~79 MB of downloaded PDFs (re-fetchable from arXiv via curated.json).
/research/papers/
